# Copy to .env and fill in. NEVER commit real .env.
LLM_PROVIDER=openai            # openai | gemini | ollama
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL_DRAFT=gpt-4o-mini    # cheap model for drafts
LLM_MODEL_REVIEW=gpt-4o        # strong model for the acid test
DB_PASSWORD=change-this
ConnectionStrings__Default=Host=db;Database=novela;Username=novela;Password=change-this
