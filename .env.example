# Copy to .env and fill in. NEVER commit real .env.

# ---- LLM (legacy global config; will move to per-user in 6.2) ----
Llm__Provider=openai            # openai | gemini | ollama
Llm__ApiKey=sk-xxxxxxxx
Llm__ModelDraft=gpt-4o-mini     # cheap model for drafts
Llm__ModelReview=gpt-4o         # strong model for the acid test

# ---- Database ----
DB_PASSWORD=tuPassword
ConnectionStrings__Default=Host=db;Database=novela;Username=postgres;Password=tuPassword

# ---- Email (SendGrid) ----
# Leave blank to fall back to ConsoleEmailSender (emails printed to logs — dev only).
SendGrid__ApiKey=
SendGrid__FromEmail=noreply@cenit-labs.com
SendGrid__FromName=CenitStoryTeller
