# Copia a .env y rellena. NUNCA comitees .env real.
LLM_PROVIDER=openai            # openai | gemini | ollama
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL_DRAFT=gpt-4o-mini    # modelo barato para borradores
LLM_MODEL_REVIEW=gpt-4o        # modelo fuerte para la prueba del ácido
DB_PASSWORD=cambia-esto
ConnectionStrings__Default=Host=db;Database=novela;Username=novela;Password=cambia-esto
