# Auto-normalize all text files to LF in the repo. Working copies get the
# native line ending of the OS (CRLF on Windows, LF on Linux/macOS).
* text=auto eol=lf

# Force LF for files where CRLF would break shell semantics or Docker.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binary files.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
