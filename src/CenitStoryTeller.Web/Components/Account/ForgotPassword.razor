@page "/forgot-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using CenitStoryTeller.Data.Entities
@inject UserManager<Usuario> UserMgr
@inject IEmailSender<Usuario> Emails
@inject NavigationManager Nav

<PageTitle>Olvidé mi contraseña · CenitStoryTeller</PageTitle>

<MudCard Elevation="4" Class="pa-6" Style="max-width: 420px; margin: 4rem auto;">
    <MudText Typo="Typo.h5" Class="mb-3">Recuperar contraseña</MudText>

    @if (_enviado)
    {
        <MudAlert Severity="Severity.Success" Dense="true">
            Si esa cuenta existe, enviamos un enlace de recuperación a <strong>@Input.Email</strong>.
            Revisa tu correo.
        </MudAlert>
        <MudButton Href="/login" Variant="Variant.Outlined" Class="mt-4">Volver</MudButton>
    }
    else
    {
        <EditForm Model="Input" method="post" OnValidSubmit="EnviarAsync" FormName="forgot-password">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="Input.Email" Label="Email" InputType="InputType.Email"
                          Required="true" Class="mb-3" Variant="Variant.Outlined" />
            <ValidationMessage For="() => Input.Email" class="text-danger" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
                Enviar enlace
            </MudButton>
        </EditForm>
    }
</MudCard>

@code {
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
    private bool _enviado;

    private async Task EnviarAsync()
    {
        var usuario = await UserMgr.FindByEmailAsync(Input.Email);
        // No revelamos si el email existe: respondemos igual exista o no.
        if (usuario is not null && await UserMgr.IsEmailConfirmedAsync(usuario))
        {
            var code = await UserMgr.GeneratePasswordResetTokenAsync(usuario);
            var encoded = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
            var link = Nav.ToAbsoluteUri($"/reset-password?code={encoded}").ToString();
            await Emails.SendPasswordResetLinkAsync(usuario, Input.Email, HtmlEncoder.Default.Encode(link));
        }
        _enviado = true;
    }

    public sealed class InputModel
    {
        [Required, EmailAddress] public string Email { get; set; } = "";
    }
}
