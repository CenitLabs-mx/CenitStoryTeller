@page "/reset-password"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using CenitStoryTeller.Data.Entities
@inject UserManager<Usuario> UserMgr
@inject NavigationManager Nav

<PageTitle>Nueva contraseña · CenitStoryTeller</PageTitle>

<MudCard Elevation="4" Class="pa-6" Style="max-width: 460px; margin: 4rem auto;">
    <MudText Typo="Typo.h5" Class="mb-3">Establecer nueva contraseña</MudText>

    @if (_errores.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
            @foreach (var err in _errores) { <div>@err</div> }
        </MudAlert>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="ResetearAsync" FormName="reset-password">
        <DataAnnotationsValidator />
        <MudTextField @bind-Value="Input.Email" Label="Email" InputType="InputType.Email"
                      Required="true" Class="mb-3" Variant="Variant.Outlined" />
        <ValidationMessage For="() => Input.Email" class="text-danger" />

        <MudTextField @bind-Value="Input.Password" Label="Nueva contraseña" InputType="InputType.Password"
                      Required="true" Class="mb-3" Variant="Variant.Outlined" />
        <ValidationMessage For="() => Input.Password" class="text-danger" />

        <MudTextField @bind-Value="Input.PasswordConfirm" Label="Confirmar contraseña"
                      InputType="InputType.Password" Required="true" Class="mb-3" Variant="Variant.Outlined" />

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
            Cambiar contraseña
        </MudButton>
    </EditForm>
</MudCard>

@code {
    [SupplyParameterFromQuery] private string? Code { get; set; }
    [SupplyParameterFromForm] private InputModel Input { get; set; } = new();
    private List<string> _errores = new();

    private async Task ResetearAsync()
    {
        _errores.Clear();
        if (string.IsNullOrEmpty(Code))
        {
            _errores.Add("Enlace inválido. Vuelve a solicitar el cambio de contraseña.");
            return;
        }
        if (Input.Password != Input.PasswordConfirm)
        {
            _errores.Add("Las contraseñas no coinciden.");
            return;
        }

        var usuario = await UserMgr.FindByEmailAsync(Input.Email);
        if (usuario is null)
        {
            // No revelamos si el email existe.
            Nav.NavigateTo("/login");
            return;
        }

        var decoded = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        var result = await UserMgr.ResetPasswordAsync(usuario, decoded, Input.Password);
        if (result.Succeeded)
        {
            Nav.NavigateTo("/login");
            return;
        }
        _errores.AddRange(result.Errors.Select(e => e.Description));
    }

    public sealed class InputModel
    {
        [Required, EmailAddress] public string Email { get; set; } = "";
        [Required, StringLength(100, MinimumLength = 8), DataType(DataType.Password)] public string Password { get; set; } = "";
        [Required, DataType(DataType.Password)] public string PasswordConfirm { get; set; } = "";
    }
}
