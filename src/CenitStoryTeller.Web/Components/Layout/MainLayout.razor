@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None" Class="d-flex align-items-center" Style="gap: .5rem;">
            <MudIcon Icon="@Icons.Material.Filled.AutoStories" />
            <MudText Typo="Typo.h6">CenitStoryTeller</MudText>
        </MudLink>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudButton Href="/configuracion" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Settings">
                    Configuración
                </MudButton>
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight">
                    <MudText Class="px-4 py-2" Typo="Typo.body2">@(context.User.Identity?.Name)</MudText>
                    <MudDivider />
                    <MudMenuItem Href="/configuracion">Configuración</MudMenuItem>
                    <MudMenuItem Href="/logout">Salir</MudMenuItem>
                </MudMenu>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/login" Color="Color.Inherit" Variant="Variant.Outlined">Iniciar sesión</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Mini" OpenMiniOnHover="true">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Inicio</MudNavLink>
            <AuthorizeView>
                <MudNavLink Href="/obras/nueva" Icon="@Icons.Material.Outlined.AddCircle">Nueva obra</MudNavLink>
                <MudNavLink Href="/configuracion" Icon="@Icons.Material.Outlined.Settings">Configuración</MudNavLink>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _drawerOpen = true;
}
