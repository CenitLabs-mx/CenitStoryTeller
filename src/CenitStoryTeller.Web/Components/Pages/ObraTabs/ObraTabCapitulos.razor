@using CenitStoryTeller.Core.Entities

@if (Capitulos is null || Capitulos.Count == 0)
{
    <MudText Align="Align.Center" Color="Color.Secondary" Class="my-4">
        <em>Sin capítulos creados aún.</em>
    </MudText>
    return;
}

<MudText Typo="Typo.h6" Class="mb-3">Capítulos</MudText>
<MudList T="Capitulo" Dense="false">
    @foreach (var c in Capitulos)
    {
        <MudListItem T="Capitulo" Value="c" Href="@($"/capitulos/{c.Id}/versiones")">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@c.Orden</MudChip>
                <div style="flex: 1;">
                    <MudText Typo="Typo.subtitle1"><b>@c.Titulo</b></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Estado: @c.Estado</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
            </MudStack>
        </MudListItem>
    }
</MudList>

@code {
    [Parameter] public List<Capitulo>? Capitulos { get; set; }
}
