@page "/obras/{ObraId:guid}/pasos"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IRegistroPasoRepository RegistroPasoRepo
@inject IObraRepository Obras

<PageTitle>Bitácora · CenitStoryTeller</PageTitle>

<MudBreadcrumbs Items="@_crumbs" Class="px-0 mb-2" />
<MudText Typo="Typo.h4" Class="mb-4">Bitácora de pasos</MudText>

@if (_pasos is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_pasos.Count == 0)
{
    <MudText>No hay pasos registrados todavía.</MudText>
}
else
{
    <MudTimeline TimelinePosition="TimelinePosition.Left">
        @foreach (var p in _pasos)
        {
            <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                <ItemContent>
                    <MudPaper Elevation="1" Class="pa-3">
                        <MudStack Row="true" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.subtitle2">@p.Agente</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @p.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2">@p.Accion</MudText>
                        @if (!string.IsNullOrWhiteSpace(p.Cambios))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@p.Cambios</MudText>
                        }
                    </MudPaper>
                </ItemContent>
            </MudTimelineItem>
        }
    </MudTimeline>
}

@code {
    [Parameter] public Guid ObraId { get; set; }
    private List<RegistroPaso>? _pasos;
    private List<BreadcrumbItem> _crumbs = new();

    protected override async Task OnParametersSetAsync()
    {
        _pasos = await RegistroPasoRepo.ListPorObraAsync(ObraId);
        var obra = await Obras.GetAsync(ObraId);
        _crumbs = new()
        {
            new BreadcrumbItem("Inicio", "/"),
            new BreadcrumbItem(obra?.Titulo ?? "Obra", $"/obras/{ObraId}"),
            new BreadcrumbItem("Bitácora", null, disabled: true)
        };
    }
}
