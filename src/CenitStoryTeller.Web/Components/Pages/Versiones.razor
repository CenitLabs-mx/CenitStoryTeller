@page "/capitulos/{CapituloId:guid}/versiones"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ICapituloRepository Capitulos
@inject IGeneracionService Generacion

<PageTitle>Versiones del capítulo</PageTitle>

@if (_capitulo is null)
{
    <p><em>Cargando…</em></p>
}
else
{
    <div class="mb-3">
        <a href="" class="btn btn-sm btn-outline-secondary">
            <span class="bi bi-arrow-left"></span> Volver al Taller
        </a>
    </div>

    <h1 class="display-6 fw-bold mb-3">@_capitulo.Titulo</h1>

    <!-- Panel para redactar/generar un borrador de este capítulo -->
    <div class="card mb-4 p-3 bg-white border shadow-sm">
        <h3 class="h6 fw-bold mb-2 text-primary"><span class="bi bi-cpu"></span> Redactar / Generar Nueva Versión</h3>
        <div class="input-group">
            <input type="text" class="form-control" @bind="_promptUsuario" 
                   placeholder="Escribe la instrucción o el enfoque de esta escena (ej: Lady Isabel reflexiona sobre su deudas)..." 
                   disabled="@_generando" />
            <button class="btn btn-primary" @onclick="GenerarNuevoBorrador" disabled="@(string.IsNullOrWhiteSpace(_promptUsuario) || _generando)">
                @if (_generando)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    <span> Trabajando...</span>
                }
                else
                {
                    <span class="bi bi-pencil-fill"></span><span> Generar Borrador</span>
                }
            </button>
        </div>
        @if (!string.IsNullOrEmpty(_statusMensaje))
        {
            <div class="alert alert-info mt-2 py-2 px-3 small mb-0 d-flex align-items-center gap-2">
                <span class="spinner-grow spinner-grow-sm text-info" role="status" aria-hidden="true"></span>
                <span>@_statusMensaje</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(_errorGeneracion))
        {
            <div class="alert alert-danger mt-2 py-1 px-2 small mb-0">@_errorGeneracion</div>
        }
    </div>

    <div class="selector mb-3 p-3 bg-light border rounded d-flex gap-3 align-items-center">
        <label class="mb-0"><strong>Izquierda:</strong>
            <select class="form-select form-select-sm d-inline-block w-auto ms-1" @bind="_izqId">
                @foreach (var v in _versiones)
                {
                    <option value="@v.Id">v@(v.NumeroVersion) · @v.Modelo @(v.EsFinal ? "★" : "")</option>
                }
            </select>
        </label>
        <label class="mb-0"><strong>Derecha:</strong>
            <select class="form-select form-select-sm d-inline-block w-auto ms-1" @bind="_derId">
                @foreach (var v in _versiones)
                {
                    <option value="@v.Id">v@(v.NumeroVersion) · @v.Modelo @(v.EsFinal ? "★" : "")</option>
                }
            </select>
        </label>
    </div>

    <div class="comparador d-flex gap-4">
        <div class="flex-fill" style="width: 50%;">
            <VersionPanel Version="Izq" OnStateChanged="RecargarDatos" />
        </div>
        <div class="flex-fill" style="width: 50%;">
            <VersionPanel Version="Der" OnStateChanged="RecargarDatos" />
        </div>
    </div>
}

@code {
    [Parameter] public Guid CapituloId { get; set; }
    private Capitulo? _capitulo;
    private List<CapituloVersion> _versiones = new();
    private Guid _izqId, _derId;

    private string _promptUsuario = "";
    private bool _generando = false;
    private string _statusMensaje = "";
    private string _errorGeneracion = "";

    private CapituloVersion? Izq => _versiones.FirstOrDefault(v => v.Id == _izqId);
    private CapituloVersion? Der => _versiones.FirstOrDefault(v => v.Id == _derId);

    protected override async Task OnParametersSetAsync()
    {
        await RecargarDatos();

        // Por defecto: comparar la penúltima con la última (o la única que haya).
        if (_versiones.Any())
        {
            _derId = _versiones.Last().Id;
            _izqId = _versiones.Count > 1 ? _versiones[^2].Id : _versiones.Last().Id;
        }
    }

    private async Task RecargarDatos()
    {
        _capitulo = await Capitulos.GetConVersionesAsync(CapituloId);
        _versiones = _capitulo?.Versiones.OrderBy(v => v.NumeroVersion).ToList() ?? new();
    }

    private async Task GenerarNuevoBorrador()
    {
        if (string.IsNullOrWhiteSpace(_promptUsuario)) return;
        _generando = true;
        _errorGeneracion = "";
        _statusMensaje = "Enviando orden al backend y conectando con la IA (DeepSeek)...";
        StateHasChanged();
        await Task.Delay(50); // Darle tiempo a Blazor para renderizar el cambio de estado inicial

        try
        {
            var versionNueva = await Generacion.GenerarBorradorAsync(CapituloId, _promptUsuario);
            _promptUsuario = ""; // Limpiar
            _statusMensaje = ""; // Limpiar
            
            // Recargar datos
            await RecargarDatos();
            
            // Seleccionar automáticamente la versión nueva a la derecha
            _derId = versionNueva.Id;
            if (_versiones.Count > 1)
            {
                _izqId = _versiones[^2].Id;
            }
        }
        catch (System.Net.Http.HttpRequestException httpEx)
        {
            _statusMensaje = "";
            _errorGeneracion = $"Error de red/conexión: No se pudo establecer conexión con la API de DeepSeek (el backend no recibió la orden): {httpEx.Message}. Verifica tu API Key o conexión a internet.";
        }
        catch (Exception ex)
        {
            _statusMensaje = "";
            _errorGeneracion = $"Error al procesar la orden en el backend: {ex.Message}";
        }
        finally
        {
            _generando = false;
        }
    }
}

