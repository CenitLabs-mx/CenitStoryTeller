@page "/obras/{ObraId:guid}"
@using Microsoft.EntityFrameworkCore
@using NovelaEngine.Data
@using NovelaEngine.Data.Entities
@inject IObraRepository Obras
@inject NovelaDbContext Db
@inject NavigationManager Nav

<PageTitle>Centro Operativo - Novela Engine</PageTitle>

@if (_obra is null)
{
    <div class="container my-5 text-center">
        <p><em>Cargando obra…</em></p>
    </div>
}
else
{
    <div class="container my-5" style="max-width: 1000px;">
        <!-- Cabecera de Navegación -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a href="" class="btn btn-sm btn-outline-secondary mb-2">
                    <span class="bi bi-arrow-left"></span> Volver al Taller
                </a>
                <h1 class="display-6 fw-bold mb-0">@_obra.Titulo</h1>
                <p class="text-muted mb-0 small">
                    <strong>Medio:</strong> @(_obra.Medio ?? "—") · 
                    <strong>Género:</strong> @(_obra.Genero ?? "—") · 
                    <strong>Intake:</strong> @_obra.Intake
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary p-2">Estado: @_obra.Estado</span>
                <a class="btn btn-outline-secondary" href="/obras/@(_obra.Id)/pasos">
                    <span class="bi bi-clock-history"></span> Bitácora de Pasos
                </a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_obra.Logline))
        {
            <blockquote class="text-muted italic small border-start border-3 ps-3 mb-4 bg-light p-2 rounded-end">
                "@_obra.Logline"
            </blockquote>
        }

        <!-- Pestañas del centro operativo -->
        <ul class="nav nav-tabs nav-fill mb-3" id="tab-detalle" role="tablist">
            <li class="nav-item">
                <button class="nav-link @(_activeTab == "caps" ? "active fw-bold" : "")" @onclick='() => _activeTab = "caps"'>
                    <span class="bi bi-list-ol"></span> Capítulos (@_capitulos.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_activeTab == "chars" ? "active fw-bold" : "")" @onclick='() => _activeTab = "chars"'>
                    <span class="bi bi-people-fill"></span> Personajes (@_obra.Personajes.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_activeTab == "locs" ? "active fw-bold" : "")" @onclick='() => _activeTab = "locs"'>
                    <span class="bi bi-geo-alt-fill"></span> Ubicaciones (@_obra.Ubicaciones.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(_activeTab == "beats" ? "active fw-bold" : "")" @onclick='() => _activeTab = "beats"'>
                    <span class="bi bi-graph-up"></span> Estructura (Beats) (@_obra.Beats.Count)
                </button>
            </li>
        </ul>

        <!-- Contenido de las pestañas -->
        <div class="tab-content border p-4 rounded bg-white shadow-2xs" style="min-height: 250px;">
            @if (_activeTab == "caps")
            {
                <!-- PESTAÑA CAPÍTULOS -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h5 fw-bold mb-0">Listado de Capítulos</h3>
                </div>

                @if (_capitulos.Count == 0)
                {
                    <p class="text-center text-muted my-4"><em>Sin capítulos creados aún.</em></p>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var c in _capitulos)
                        {
                            <a href="/capitulos/@(c.Id)/versiones" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <strong class="text-primary">@c.Orden. @c.Titulo</strong>
                                    <span class="text-muted small ms-2">— Estado: @c.Estado</span>
                                </div>
                                <span class="btn btn-sm btn-outline-primary py-0">Entrar al Taller</span>
                            </a>
                        }
                    </div>
                }
            }
            else if (_activeTab == "chars")
            {
                <!-- PESTAÑA PERSONAJES -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h5 fw-bold mb-0">Fichas de Personajes</h3>
                    <button class="btn btn-sm btn-primary" @onclick="IniciarNuevoPersonaje">
                        <span class="bi bi-person-plus"></span> Añadir Personaje
                    </button>
                </div>

                @if (_obra.Personajes.Count == 0)
                {
                    <p class="text-center text-muted my-4"><em>Sin personajes registrados en el canon.</em></p>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var p in _obra.Personajes)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 border shadow-2xs">
                                    <div class="card-body p-3 d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h5 class="card-title h6 mb-0 fw-bold">@p.Nombre</h5>
                                            <span class="badge @(p.EstadoVital == EstadoVital.Vivo ? "bg-success" : "bg-danger")" style="font-size: 0.7rem;">
                                                @p.EstadoVital
                                            </span>
                                        </div>
                                        <p class="card-subtitle mb-2 text-muted small">@p.Rol · <span class="italic">@p.Arquetipo</span></p>
                                        @if (!string.IsNullOrWhiteSpace(p.Deseo))
                                        {
                                            <div class="small mb-1"><strong>Deseo:</strong> @p.Deseo</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(p.HeridaCentral))
                                        {
                                            <div class="small text-danger flex-grow-1"><strong>Herida:</strong> @p.HeridaCentral</div>
                                        }
                                        <div class="d-flex gap-2 mt-3 pt-2 border-top justify-content-end">
                                            <button class="btn btn-xs btn-outline-primary py-0" @onclick="() => IniciarEditarPersonaje(p)">Editar</button>
                                            <button class="btn btn-xs btn-outline-danger py-0" @onclick="() => EliminarPersonaje(p)">Eliminar</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else if (_activeTab == "locs")
            {
                <!-- PESTAÑA UBICACIONES -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h5 fw-bold mb-0">Fichas de Ubicaciones</h3>
                    <button class="btn btn-sm btn-primary" @onclick="IniciarNuevaUbicacion">
                        <span class="bi bi-geo-alt"></span> Añadir Ubicación
                    </button>
                </div>

                @if (_obra.Ubicaciones.Count == 0)
                {
                    <p class="text-center text-muted my-4"><em>Sin ubicaciones registradas en el canon.</em></p>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var l in _obra.Ubicaciones)
                        {
                            <div class="col-md-6">
                                <div class="card h-100 border">
                                    <div class="card-body p-3 d-flex flex-column">
                                        <h5 class="card-title h6 fw-bold mb-1">@l.Nombre</h5>
                                        <p class="card-subtitle mb-2 text-muted small">Tipo: @l.Tipo</p>
                                        @if (!string.IsNullOrWhiteSpace(l.RolEnTrama))
                                        {
                                            <div class="small mb-1"><strong>Rol Narrativo:</strong> @l.RolEnTrama</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(l.EstadoActual))
                                        {
                                            <div class="small text-muted flex-grow-1"><strong>Estado:</strong> @l.EstadoActual</div>
                                        }
                                        <div class="d-flex gap-2 mt-3 pt-2 border-top justify-content-end">
                                            <button class="btn btn-xs btn-outline-primary py-0" @onclick="() => IniciarEditarUbicacion(l)">Editar</button>
                                            <button class="btn btn-xs btn-outline-danger py-0" @onclick="() => EliminarUbicacion(l)">Eliminar</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else if (_activeTab == "beats")
            {
                <!-- PESTAÑA BEATS -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h5 fw-bold mb-0">Estructura de la Novela (Beats)</h3>
                    <button class="btn btn-sm btn-primary" @onclick="IniciarNuevoBeat">
                        <span class="bi bi-graph-up"></span> Añadir Beat
                    </button>
                </div>

                @if (_obra.Beats.Count == 0)
                {
                    <p class="text-center text-muted my-4"><em>Sin beats dramáticos estructurados.</em></p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle small">
                            <thead>
                                <tr>
                                    <th>Ord.</th>
                                    <th>Título</th>
                                    <th>Acto</th>
                                    <th>Función</th>
                                    <th>Descripción</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in _obra.Beats.OrderBy(x => x.Orden))
                                {
                                    <tr>
                                        <td>@b.Orden</td>
                                        <td><strong>@b.Titulo</strong></td>
                                        <td><span class="badge bg-light text-dark border">@b.Acto</span></td>
                                        <td><span class="badge bg-light text-primary border">@b.Funcion</span></td>
                                        <td class="text-muted">@b.Descripcion</td>
                                        <td class="text-end">
                                            <button class="btn btn-xs btn-outline-primary py-0 me-1" @onclick="() => IniciarEditarBeat(b)">Editar</button>
                                            <button class="btn btn-xs btn-outline-danger py-0" @onclick="() => EliminarBeat(b)">Eliminar</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>

    <!-- MODAL EDITAR / AÑADIR PERSONAJE -->
    @if (_editingPersonaje is not null)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">@(_isNewItem ? "Añadir Personaje" : "Editar Personaje")</h5>
                        <button type="button" class="btn-close" @onclick="() => _editingPersonaje = null"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Nombre Completo:</label>
                            <input class="form-control form-control-sm" @bind="_editingPersonaje.Nombre" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Rol (Protagonista/Antagonista/Secundario):</label>
                            <input class="form-control form-control-sm" @bind="_editingPersonaje.Rol" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Arquetipo:</label>
                            <input class="form-control form-control-sm" @bind="_editingPersonaje.Arquetipo" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Herida Central:</label>
                            <input class="form-control form-control-sm" @bind="_editingPersonaje.HeridaCentral" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Deseo Principal:</label>
                            <input class="form-control form-control-sm" @bind="_editingPersonaje.Deseo" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Necesidad de Cambio:</label>
                            <input class="form-control form-control-sm" @bind="_editingPersonaje.Necesidad" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Estado en la Trama:</label>
                            <input class="form-control form-control-sm" @bind="_editingPersonaje.EstadoEnTrama" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Estado Vital:</label>
                            <select class="form-select form-select-sm" @bind="_editingPersonaje.EstadoVital">
                                @foreach (var ev in Enum.GetValues<EstadoVital>())
                                {
                                    <option value="@ev">@ev</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="() => _editingPersonaje = null">Cancelar</button>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="GuardarPersonaje">Guardar</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- MODAL EDITAR / AÑADIR UBICACIÓN -->
    @if (_editingUbicacion is not null)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">@(_isNewItem ? "Añadir Ubicación" : "Editar Ubicación")</h5>
                        <button type="button" class="btn-close" @onclick="() => _editingUbicacion = null"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Nombre de la Ubicación:</label>
                            <input class="form-control form-control-sm" @bind="_editingUbicacion.Nombre" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Tipo (Edificio/Ciudad/Bosque/Nave/etc):</label>
                            <input class="form-control form-control-sm" @bind="_editingUbicacion.Tipo" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Rol Narrativo / Importancia:</label>
                            <input class="form-control form-control-sm" @bind="_editingUbicacion.RolEnTrama" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Estado Inicial / Actual:</label>
                            <input class="form-control form-control-sm" @bind="_editingUbicacion.EstadoActual" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="() => _editingUbicacion = null">Cancelar</button>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="GuardarUbicacion">Guardar</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- MODAL EDITAR / AÑADIR BEAT -->
    @if (_editingBeat is not null)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold">@(_isNewItem ? "Añadir Beat" : "Editar Beat")</h5>
                        <button type="button" class="btn-close" @onclick="() => _editingBeat = null"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-2 mb-2">
                            <div class="col-4">
                                <label class="form-label small fw-bold">Orden:</label>
                                <input type="number" class="form-control form-control-sm" @bind="_editingBeat.Orden" />
                            </div>
                            <div class="col-8">
                                <label class="form-label small fw-bold">Título:</label>
                                <input class="form-control form-control-sm" @bind="_editingBeat.Titulo" />
                            </div>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label small fw-bold">Acto:</label>
                                <select class="form-select form-select-sm" @bind="_editingBeat.Acto">
                                    @foreach (var a in Enum.GetValues<Acto>())
                                    {
                                        <option value="@a">@a</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold">Función Narrativa:</label>
                                <select class="form-select form-select-sm" @bind="_editingBeat.Funcion">
                                    @foreach (var f in Enum.GetValues<FuncionNarrativa>())
                                    {
                                        <option value="@f">@f</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Descripción / Acción del Beat:</label>
                            <textarea class="form-control form-control-sm" rows="3" @bind="_editingBeat.Descripcion"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-secondary" @onclick="() => _editingBeat = null">Cancelar</button>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="GuardarBeat">Guardar</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Guid ObraId { get; set; }
    private Obra? _obra;
    private List<Capitulo> _capitulos = new();
    private string _activeTab = "caps";

    // Estados de edición
    private Personaje? _editingPersonaje;
    private Ubicacion? _editingUbicacion;
    private Beat? _editingBeat;
    private bool _isNewItem = false;

    protected override async Task OnInitializedAsync()
    {
        await RecargarDatos();
    }

    private async Task RecargarDatos()
    {
        _obra = await Obras.GetConCanonAsync(ObraId);
        _capitulos = (_obra?.Capitulos ?? new List<Capitulo>())
            .OrderBy(c => c.Orden)
            .ToList();
    }

    // ----- PERSONAJES -----
    private void IniciarNuevoPersonaje()
    {
        _isNewItem = true;
        _editingPersonaje = new Personaje
        {
            ObraId = ObraId,
            EstadoVital = EstadoVital.Vivo,
            Canon = CanonNivel.Borrador
        };
    }

    private void IniciarEditarPersonaje(Personaje p)
    {
        _isNewItem = false;
        // Clonar para evitar cambios reactivos parciales antes de guardar
        _editingPersonaje = new Personaje
        {
            Id = p.Id,
            ObraId = p.ObraId,
            Nombre = p.Nombre,
            Rol = p.Rol,
            Arquetipo = p.Arquetipo,
            HeridaCentral = p.HeridaCentral,
            Deseo = p.Deseo,
            Necesidad = p.Necesidad,
            EstadoEnTrama = p.EstadoEnTrama,
            EstadoVital = p.EstadoVital,
            Canon = p.Canon
        };
    }

    private async Task GuardarPersonaje()
    {
        if (_editingPersonaje is null || string.IsNullOrWhiteSpace(_editingPersonaje.Nombre)) return;

        if (_isNewItem)
        {
            _editingPersonaje.Id = Guid.NewGuid();
            await Db.Personajes.AddAsync(_editingPersonaje);
        }
        else
        {
            var pDb = await Db.Personajes.FirstOrDefaultAsync(x => x.Id == _editingPersonaje.Id);
            if (pDb is not null)
            {
                pDb.Nombre = _editingPersonaje.Nombre;
                pDb.Rol = _editingPersonaje.Rol;
                pDb.Arquetipo = _editingPersonaje.Arquetipo;
                pDb.HeridaCentral = _editingPersonaje.HeridaCentral;
                pDb.Deseo = _editingPersonaje.Deseo;
                pDb.Necesidad = _editingPersonaje.Necesidad;
                pDb.EstadoEnTrama = _editingPersonaje.EstadoEnTrama;
                pDb.EstadoVital = _editingPersonaje.EstadoVital;
            }
        }

        await Db.SaveChangesAsync();
        _editingPersonaje = null;
        await RecargarDatos();
    }

    private async Task EliminarPersonaje(Personaje p)
    {
        Db.Personajes.Remove(p);
        await Db.SaveChangesAsync();
        await RecargarDatos();
    }

    // ----- UBICACIONES -----
    private void IniciarNuevaUbicacion()
    {
        _isNewItem = true;
        _editingUbicacion = new Ubicacion
        {
            ObraId = ObraId,
            Canon = CanonNivel.Borrador
        };
    }

    private void IniciarEditarUbicacion(Ubicacion l)
    {
        _isNewItem = false;
        _editingUbicacion = new Ubicacion
        {
            Id = l.Id,
            ObraId = l.ObraId,
            Nombre = l.Nombre,
            Tipo = l.Tipo,
            RolEnTrama = l.RolEnTrama,
            EstadoActual = l.EstadoActual,
            Canon = l.Canon
        };
    }

    private async Task GuardarUbicacion()
    {
        if (_editingUbicacion is null || string.IsNullOrWhiteSpace(_editingUbicacion.Nombre)) return;

        if (_isNewItem)
        {
            _editingUbicacion.Id = Guid.NewGuid();
            await Db.Ubicaciones.AddAsync(_editingUbicacion);
        }
        else
        {
            var lDb = await Db.Ubicaciones.FirstOrDefaultAsync(x => x.Id == _editingUbicacion.Id);
            if (lDb is not null)
            {
                lDb.Nombre = _editingUbicacion.Nombre;
                lDb.Tipo = _editingUbicacion.Tipo;
                lDb.RolEnTrama = _editingUbicacion.RolEnTrama;
                lDb.EstadoActual = _editingUbicacion.EstadoActual;
            }
        }

        await Db.SaveChangesAsync();
        _editingUbicacion = null;
        await RecargarDatos();
    }

    private async Task EliminarUbicacion(Ubicacion l)
    {
        Db.Ubicaciones.Remove(l);
        await Db.SaveChangesAsync();
        await RecargarDatos();
    }

    // ----- BEATS -----
    private void IniciarNuevoBeat()
    {
        _isNewItem = true;
        _editingBeat = new Beat
        {
            ObraId = ObraId,
            Orden = _obra?.Beats.Count + 1 ?? 1,
            Estado = BeatEstado.Pendiente
        };
    }

    private void IniciarEditarBeat(Beat b)
    {
        _isNewItem = false;
        _editingBeat = new Beat
        {
            Id = b.Id,
            ObraId = b.ObraId,
            Orden = b.Orden,
            Titulo = b.Titulo,
            Acto = b.Acto,
            Funcion = b.Funcion,
            Descripcion = b.Descripcion,
            Estado = b.Estado
        };
    }

    private async Task GuardarBeat()
    {
        if (_editingBeat is null || string.IsNullOrWhiteSpace(_editingBeat.Titulo)) return;

        if (_isNewItem)
        {
            _editingBeat.Id = Guid.NewGuid();
            await Db.Beats.AddAsync(_editingBeat);

            // Crear automáticamente el marcador de capítulo para el nuevo beat
            await Db.Capitulos.AddAsync(new Capitulo
            {
                Id = Guid.NewGuid(),
                ObraId = ObraId,
                Orden = _editingBeat.Orden,
                Titulo = _editingBeat.Titulo,
                Estado = CapituloEstado.Borrador
            });
        }
        else
        {
            var bDb = await Db.Beats.FirstOrDefaultAsync(x => x.Id == _editingBeat.Id);
            if (bDb is not null)
            {
                bDb.Orden = _editingBeat.Orden;
                bDb.Titulo = _editingBeat.Titulo;
                bDb.Acto = _editingBeat.Acto;
                bDb.Funcion = _editingBeat.Funcion;
                bDb.Descripcion = _editingBeat.Descripcion;
            }

            // Actualizar también el título del capítulo correspondiente si existe
            var cDb = await Db.Capitulos.FirstOrDefaultAsync(x => x.ObraId == ObraId && x.Orden == _editingBeat.Orden);
            if (cDb is not null)
            {
                cDb.Titulo = _editingBeat.Titulo;
            }
        }

        await Db.SaveChangesAsync();
        _editingBeat = null;
        await RecargarDatos();
    }

    private async Task EliminarBeat(Beat b)
    {
        // Remover beat
        Db.Beats.Remove(b);

        // Remover capítulo asociado
        var cDb = await Db.Capitulos.FirstOrDefaultAsync(x => x.ObraId == ObraId && x.Orden == b.Orden);
        if (cDb is not null)
        {
            Db.Capitulos.Remove(cDb);
        }

        await Db.SaveChangesAsync();
        await RecargarDatos();
    }
}
